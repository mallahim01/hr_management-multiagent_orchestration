# Groq — default provider (config.yaml: llm.provider = groq).
# Extra keys are optional spares; the LLM wrapper rotates to the next one
# when a key hits its free-tier rate limit.
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# OpenAI — only needed when config.yaml sets llm.provider = openai
OPENAI_API_KEY=your-openai-api-key-here

# Google — only needed by the ADK backend (orchestrator_backend: adk)
GOOGLE_API_KEY=your-google-api-key-here
