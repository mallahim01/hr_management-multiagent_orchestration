venv/
.venv/
.env
__pycache__/
*.pyc
*.sqlite3

# Runtime artefacts regenerated on every run — not source
data/*.db
data/*.db-wal
data/*.db-shm
data/interactions.log
data/report.html
data/langgraph_flow.png

# Live logs are ignored, but the captured sample run in logs/ is committed
# on purpose so the system's behaviour is inspectable without running it.
logs/*.log
!logs/sample-session.log
